@{
    var initialMarkup = @"<h2>
    <img src=""https://js.devexpress.com/Demos/WidgetsGallery/JSDemos/images/widgets/HtmlEditor.svg"" alt=""HtmlEditor"" />
    Formatted Text Editor (HTML Editor)
  </h2>
  <br>
  <p>DevExtreme HTML Editor is a client-side WYSIWYG text editor that allows its users to format textual and visual content and store it as HTML or Markdown.</p>
  <p>Supported features:</p>
  <ul>
    <li>Inline formats:
      <ul>
        <li><strong>Bold</strong>, <em>italic</em>, <s>strikethrough</s> text formatting</li>
        <li>Font, size, color changes (HTML only)</li>
      </ul>
    </li>
    <li>Block formats:
      <ul>
        <li>Headers</li>
        <li>Text alignment</li>
        <li>Lists (ordered and unordered)</li>
        <li>Code blocks</li>
        <li>Quotes</li>
      </ul>
    </li>
    <li>Custom formats</li>
    <li>HTML and Markdown support</li>
    <li>Mail-merge placeholders (for example, %username%)</li>
  </ul>
  <br>
  <p>The editor supports the following modules:</p>
  <table style=""width: 100%;"">
    <tbody>
      <tr>
        <td><strong>Module</strong></td>
        <td><strong>Description</strong></td>
      </tr>
      <tr>
        <td><code>toolbar</code></td>
        <td>Specifies the collection of toolbar items.</td>
      </tr>
      <tr>
        <td><code>mentions</code></td>
        <td>Allows users to mention individuals or include other data.</td>
      </tr>
      <tr>
        <td><code>variables</code></td>
        <td>Allows users to insert predefined variables.</td>
      </tr>
    </tbody>
  </table>";
}

@(Html.DevExtreme().HtmlEditor()
    .Value(new JS("initialMarkup"))
    .Toolbar(toolbar => toolbar.Items(items => {
        items.Add().Name("undo");
        items.Add().Name("redo");
        items.Add().Name("separator");
        items.Add().Name("header")
            .AcceptedValues(new JS("[false, 1, 2, 3, 4, 5]"));
        items.Add().Name("separator");
        items.Add().Name("bold");
        items.Add().Name("italic");
        items.Add().Name("strike");
        items.Add().Name("underline");
        items.Add().Name("separator");
        items.Add().Name("alignLeft");
        items.Add().Name("alignCenter");
        items.Add().Name("alignRight");
        items.Add().Name("alignJustify");
        items.Add().Name("separator");
        items.Add().Name("insertTable");
        items.Add().Name("insertHeaderRow");
        items.Add().Name("insertRowAbove");
        items.Add().Name("insertRowBelow");
        items.Add().Name("separator");
        items.Add().Name("insertColumnLeft");
        items.Add().Name("insertColumnRight");
        items.Add().Name("separator");
        items.Add().Name("deleteColumn");
        items.Add().Name("deleteRow");
        items.Add().Name("deleteTable");
        items.Add().Name("separator");
        items.Add().Name("cellProperties");
        items.Add().Name("tableProperties");
        items.Add().Widget(w => w.Button()
            .Text("Show markup")
            .StylingMode(ButtonStylingMode.Text)
            .OnClick("onShowMarkupClick")
        );
    }))
)

@(Html.DevExtreme().Popup()
    .ID("popup")
    .ShowTitle(true)
    .Title("Markup")
    .Width("80%")
    .Height("80%")
    .ShowCloseButton(true)
    .HideOnOutsideClick(true)
    .OnShown("onPopupShown")
    .ContentTemplate(new TemplateName("popupContent"))
)

<script type="text/html" id="popupContent">
    <div class="value-content"></div>
</script>

<script>
    const initialMarkup = @Html.Raw(Json.Serialize(initialMarkup));

    function onShowMarkupClick() {
        const popup = $("#popup").dxPopup("instance");
        popup.show();
    }

    function onPopupShown() {
        const editor = $(".dx-htmleditor").dxHtmlEditor("instance");
        const container = $(".value-content");
        createDocumentWithMarkup(editor, container);
    }
</script>
